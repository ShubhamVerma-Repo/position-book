{
  "info": {
    "name": "Position Book API",
    "description": "JPMC technical exercise - Position Book. Covers all 4 spec examples, position lookups, and every validation/error rule enforced by the API. Run folders 1-4 in order first (they build shared state on ACC1/SEC1) before folders 5-9, which use their own isolated accounts and do not depend on prior requests. Restart the app between full runs to avoid duplicate-id conflicts on ids reused across passes. Note: the two concurrency tests proving thread-safety (20 threads racing on one event id, 50 threads with distinct ids) cannot be represented in Postman, since they require real multi-threaded execution - these are covered as actual Java tests in PositionBookRepositoryTest instead.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "1. Spec Example 1 - Buying Securities",
      "item": [
        {
          "name": "Buy 1: ACC1/SEC1 qty 100",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": 1,\n  \"account\": \"ACC1\",\n  \"securityId\": \"SEC1\",\n  \"quantity\": 100\n}"
            },
            "url": "{{baseUrl}}/api/v1/trades/buy"
          }
        },
        {
          "name": "Buy 2: ACC1/SEC1 qty 50 (expect net 150)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": 2,\n  \"account\": \"ACC1\",\n  \"securityId\": \"SEC1\",\n  \"quantity\": 50\n}"
            },
            "url": "{{baseUrl}}/api/v1/trades/buy"
          }
        }
      ]
    },
